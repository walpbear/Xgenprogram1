/* FurBrush: editable Windows 7-inspired widget theme.
   Install the bundled Geist Pixel font first, or change its name below to Segoe UI.
   Restart through Start-FurBrush.bat after editing. */
QWidget { font-family: "Geist Pixel"; font-size: 10pt; color: #17304e; background-color: #e7eff8; }
QMainWindow, QDialog { background: #e7eff8; }
QMenuBar, QToolBar, QStatusBar {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #fbfcfd,stop:0.48 #eff4f8,stop:0.5 #e0e8f1,stop:1 #d8e2ec);
 color: #18314f; border: 1px solid #a8b9cc;
}
QMenuBar { padding: 2px; }
QMenuBar::item { background: transparent; padding: 4px 10px; border: 1px solid transparent; }
QMenuBar::item:selected, QMenuBar::item:pressed {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f5f9fc,stop:1 #c5daee);
 border: 1px solid #90a3b9; border-radius: 3px;
}
QMenu { background: #f5f8fc; border: 1px solid #8b9db3; padding: 3px; }
QMenu::item { padding: 5px 26px 5px 22px; border: 1px solid transparent; }
QMenu::item:selected { background: #d2e2f1; border: 1px solid #8da0b5; border-radius: 2px; }
QMenu::item:disabled { color: #8491a1; }
QMenu::separator { height: 1px; background: #c7ced6; margin: 4px 5px 4px 22px; }
QToolBar { spacing: 4px; padding: 4px; }
QToolBar::separator { background: #b2bac2; width: 1px; height: 1px; margin: 3px; }
QDockWidget { color: #18314f; }
QDockWidget::title {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f8fafc,stop:0.48 #dce6ef,stop:0.5 #ced7e0,stop:1 #e1e9f2);
 border: 1px solid #96aac1; padding: 5px 7px;
}
QGroupBox { background: #f0f5fb; border: 1px solid #aebed0; border-radius: 3px; margin-top: 13px; padding: 9px 5px 5px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 5px; color: #344a64; }
QLabel { background: transparent; color: #17304e; }
QLabel#moduleLabel { font-size: 13pt; color: #364c66; padding: 5px; }
QPushButton, QToolButton {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:0.48 #f1f5f9,stop:0.5 #dbe5ef,stop:1 #eaf0f6);
 color: #17304e; border: 1px solid #8b9db3; border-radius: 3px; padding: 4px 8px; min-height: 16px;
}
QPushButton:hover, QToolButton:hover {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #fbfcfe,stop:0.48 #edf3fa,stop:0.5 #d4e3f2,stop:1 #ecf3f9);
 border-color: #8293a7;
}
QPushButton:pressed, QToolButton:pressed, QToolButton:checked {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #bad3ea,stop:1 #e6eff7);
 border-color: #6d7b8c;
}
QPushButton:default { border: 2px solid #8293a7; padding: 3px 7px; }
QPushButton:disabled, QToolButton:disabled { background: #dee7f1; color: #8491a1; border-color: #b5c3d4; }
QToolButton#CollapsibleHeader { color: #17304e; border-radius: 2px; padding: 5px 8px; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
 background: #ffffff; color: #162f4c; border: 1px solid #97abc2; border-radius: 2px; padding: 3px 5px;
 selection-background-color: #3b82c4; selection-color: #000000;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #8091a4; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled { background: #ededed; color: #8996a5; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 19px; border-left: 1px solid #b0bfd1; background: #ececec; }
QComboBox QAbstractItemView { background: white; color: #17304e; selection-background-color: #d2e2f1; selection-color: #000000; }
QAbstractItemView { background: #ffffff; alternate-background-color: #f4f4f4; color: #17304e; border: 1px solid #a3b5c9; selection-background-color: #cfe0f0; selection-color: #000000; }
QAbstractItemView::item { padding: 3px; }
QAbstractItemView::item:selected { background: #cfe0f0; color: #162d49; }
QAbstractItemView::item:hover { background: #ebf2f9; }
QHeaderView::section { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #e0e8f1); color: #2c435e; padding: 5px; border: 1px solid #afbed0; }
QTabWidget::pane { background: #f1f6fb; border: 1px solid #9aaec4; }
QTabBar::tab { background: #dce6f0; border: 1px solid #a2b4c8; border-top-left-radius: 3px; border-top-right-radius: 3px; padding: 6px 10px; margin-right: 2px; }
QTabBar::tab:selected { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #eff5fa); border-bottom-color: #f2f4f7; }
QTabBar::tab:hover { background: #eff5fa; }
QCheckBox, QRadioButton { background: transparent; color: #17304e; spacing: 5px; }
QSlider::groove:horizontal { height: 5px; background: #cad1d9; border: 1px solid #9cafc5; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #89b4db; }
QSlider::handle:horizontal { width: 12px; margin: -6px 0; border: 1px solid #7b8c9e; border-radius: 3px; background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #ffffff,stop:1 #d4dce4); }
QScrollArea { background: #e7eff8; border: 0; }
QScrollArea > QWidget > QWidget { background: #e7eff8; }
QScrollBar:vertical { background: #e9f0f9; width: 15px; margin: 0; border: 1px solid #becbd9; }
QScrollBar:horizontal { background: #e9f0f9; height: 15px; margin: 0; border: 1px solid #becbd9; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #ced8e1; border: 1px solid #9baec4; border-radius: 2px; min-height: 22px; min-width: 22px; }
QScrollBar::handle:hover { background: #b4cfe9; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QProgressBar { background: #e5edf6; color: #304661; border: 1px solid #a7b8cb; border-radius: 2px; text-align: center; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #cddff0,stop:0.5 #8fb7dd,stop:1 #649cd0); }
QToolTip { background: #fafcfe; color: #1c3451; border: 1px solid #94a7be; padding: 5px; }
QMessageBox { background: #f0f5fb; }
QMessageBox QLabel { color: #17304e; }
QSplitter::handle { background: #cdd4dc; }

/* Assets are resolved from the application directory set by the launchers. */
QComboBox::down-arrow { image: url(themes/arrow-down.png); width: 8px; height: 6px; }
QSpinBox, QDoubleSpinBox { padding-right: 19px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 16px; background: #eeeeee; border-left: 1px solid #a8b9cc; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 16px; background: #eeeeee; border-left: 1px solid #a8b9cc; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(themes/arrow-up.png); width: 8px; height: 6px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(themes/arrow-down.png); width: 8px; height: 6px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background: #d5e4f2; }
QCheckBox::indicator { width: 13px; height: 13px; background: white; border: 1px solid #8698ad; border-radius: 1px; }
QCheckBox::indicator:checked { image: url(themes/check.png); }
QCheckBox::indicator:disabled { background: #e6e6e6; border-color: #b5c3d4; }

/* Solid selection surfaces keep automatic selection text contrast predictable. */
QMenuBar::item:selected, QMenuBar::item:pressed, QMenu::item:selected,
QAbstractItemView::item:selected, QTabBar::tab:selected, QToolButton:checked {
 background: #3b82c4; color: #000000;
}
